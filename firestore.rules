rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function admin() { return request.auth != null && request.auth.uid == 'REPLACE_WITH_ADMIN_UID' && request.auth.token.firebase.sign_in_provider == 'password'; }
  match /bookings/{id} {
   allow create: if request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous' && request.resource.data.clientUid == request.auth.uid && request.resource.data.status == 'Pending' && request.resource.data.paymentStatus == 'Pending verification' && request.resource.data.keys().hasOnly(['clientUid','name','phone','email','reason','type','method','transaction','receiptPath','receiptType','status','paymentStatus','appointmentAt','adminNote','createdAt']) && request.resource.data.receiptPath.matches('receipts/' + request.auth.uid + '/.*');
   allow read: if admin() || (request.auth != null && resource.data.clientUid == request.auth.uid);
   allow update, delete: if admin();
  }
 }
}
