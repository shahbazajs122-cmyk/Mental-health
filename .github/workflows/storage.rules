rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function admin() { return request.auth != null && request.auth.uid == 'REPLACE_WITH_ADMIN_UID' && request.auth.token.firebase.sign_in_provider == 'password'; }
  match /receipts/{uid}/{random}/{filename} {
   allow create: if request.auth != null && request.auth.uid == uid && request.auth.token.firebase.sign_in_provider == 'anonymous' && request.resource.size <= 5 * 1024 * 1024 && request.resource.contentType in ['image/jpeg','image/png','image/webp','application/pdf'];
   allow read: if admin() || (request.auth != null && request.auth.uid == uid);
   allow update, delete: if admin();
  }
 }
}
